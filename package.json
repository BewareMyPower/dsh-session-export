{
  "name": "@bewaremypower/dsh-session-export",
  "version": "0.1.0",
  "description": "DSH plugin that exports a Session as a self-contained interactive HTML page and opens it in the right Sidebar.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./html": "./html.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "html.js",
    "html.d.ts",
    "markdown.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "license": "MIT"
}
